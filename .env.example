# ── Supabase (required) ──────────────────────────────────────
# For local dev: run `supabase start` and copy the printed values here.
# For cloud:     Dashboard → Settings → API
SUPABASE_PROJECT_REF=
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=
NUXT_SUPABASE_SECRET_KEY=

# ── AI — optional (for resume parsing) ───────────────────────
DEEPSEEK_API_KEY=
GOOGLE_FONTS_API_KEY=

# ── Email — optional (for feedback feature) ──────────────────
NUXT_RESEND_API_KEY=
NUXT_FEEDBACK_TO_EMAIL=
NUXT_FEEDBACK_FROM_EMAIL=
